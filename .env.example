# Supabase server-side connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Must be a server-only key: modern sb_secret_... (preferred) or legacy service_role JWT.
# Never put sb_publishable_... or anon/public keys here.
SUPABASE_SERVICE_ROLE_KEY=

# AliExpress Open Platform
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# PayPal checkout. Keep the secret server-only.
# Generic adapter selection. Keep PayPal until a real Route B provider is approved and implemented.
PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Keep sandbox during testing. Change only after LIVE credentials are installed and launch readiness passes.
PAYPAL_ENVIRONMENT=sandbox

# Fourthwall Merchant of Record candidate. Keep disabled until Fourthwall has
# verified payouts for the owner, approved the self-sourced product category,
# and issued genuine API/webhook credentials.
FOURTHWALL_APPROVED=false
FOURTHWALL_SHOP_URL=
FOURTHWALL_API_KEY=
FOURTHWALL_WEBHOOK_SECRET=

# CJ fulfillment. Keep the API key server-only.
CJ_API_KEY=
# Safe defaults: sandbox enabled and automatic supplier charging disabled.
CJ_SANDBOX=true
CJ_AUTO_PAY=false

# Optional scheduled-worker authentication.
CRON_SECRET=

# Personal-import checkout estimate. Keep these aligned with current official rules/rates.
PERSONAL_IMPORT_THRESHOLD_USD=75
IMPORT_USD_ILS_RATE=3.70
IMPORT_VAT_RATE=0.18

# Automatic customer pricing. Defaults target 25 ILS after a 40% tax and insurance reserve.
AUTO_PRICING_ENABLED=true
PRICING_TARGET_NET_PROFIT_ILS=25
PRICING_VAT_RATE=0.18
PRICING_SERVICE_FEE_RATE=0.05
PRICING_PROCESSING_FEE_RATE=0.03
PRICING_TAX_RESERVE_RATE=0.40
PRICING_AD_COST_ILS=15
PRICING_CANCELLATION_RATE=0.05
PRICING_REFUND_FEE_ILS=49
PRICING_SUPPLIER_BUFFER_RATE=0.05
PRICING_PRICE_ENDING=0.90

# Vercel provides VERCEL_URL automatically at runtime.
# Never commit real secrets to this file.
